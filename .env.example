PORT=3001
CORS_ORIGINS=http://localhost:5173

# Postgres. Pooled URL for the app; direct (unpooled) URL for migrations and the seed.
# sslmode=require verifies against system CAs; verify-full needs sslrootcert (path relative to backend/) or DATABASE_SSL_CA.
DATABASE_URL=postgresql://user:pass@host-pooler/db?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL_CA=./ca.pem
# DATABASE_POOL_MAX=10

SESSION_ABSOLUTE_TTL=7d
SESSION_IDLE_TTL=1d

# Used once by `pnpm db:seed` to create the first superadmin.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Super Admin
SEED_TENANT_NAME=Infynix

# File uploads: an S3-compatible bucket (Neon Object Storage). Keys from the provider's console.
S3_BUCKET=agency-os
AWS_ENDPOINT_URL_S3=https://<branch>.storage.<region>.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
